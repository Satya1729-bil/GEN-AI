# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# Free key from Google AI Studio: https://aistudio.google.com/apikey
# Needed for search (embeddings) and for written answers.
GEMINI_API_KEY=

# Gemini model for answers. Change it if Google renames or retires the model.
GEMINI_MODEL=gemini-3.8-flash

# Search backend: "gemini" (default, no PyTorch) or "local" (offline, needs requirements-local.txt)
RX_EMBED_BACKEND=gemini
RX_GEMINI_EMBED_MODEL=gemini-embedding-2

# Optional: set a password to protect the app when it is online.
APP_PASSWORD=

# Optional: turn off PDF uploads in the browser (true or false).
RX_ALLOW_UPLOAD=true

# Optional tuning
# RX_DATA_DIR=data
# RX_INDEX_DIR=index
# RX_TOP_K=5
# RX_MIN_SCORE=0.20
# RX_CHUNK_SIZE=1200
# RX_CHUNK_OVERLAP=150
# RX_MAX_UPLOAD_MB=25
# RX_EMBED_DIMENSION=768
# RX_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
